---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import KeyBindings from "../components/KeyBindings.astro";
import "../style/global.css";
interface Props {
  filename: string;
  title: string;
}

const { filename, title = "Samsara" } = Astro.props;
---

<!doctype html>
<html data-webtui-theme="catppuccin-mocha" lang="en">
  <Head title={title} />
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <KeyBindings />
    <Footer filename={filename} />
  </body>
</html>

<style>
  html,
  body {
    width: 100%;
    height: 100%;
    min-height: 100dvh;
    margin: 0ch auto;
    position: relative;
    overflow-x: hidden;
  }

  body {
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: center;
  }

  main {
    flex: 1;
    padding: 3ch 2ch;
    width: 100%;
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  type VimMode = "NORMAL" | "BLOG";

  let modeElement = document.getElementById("vim-mode");
  let blogBox = document.getElementById("blog-box");
  let blogEntries = document.querySelectorAll(
    ".blog-entry-parent-flex-wrapper",
  );

  const lastPage =
    blogEntries.length > 0
      ? Math.max(
          ...Array.from(blogEntries, (blogEntry) =>
            Number((blogEntry as HTMLElement).dataset.page),
          ),
        )
      : 1;

  const isKeybindingsOverlayOpen = () =>
    document.getElementById("keybindings-overlay")?.style.display === "block";

  let currentMode: VimMode = "NORMAL";
  let currentIndex = 0;
  let currentPage = 1;

  const clampedPage = (currentPage: number) => {
    if (currentPage <= 0) return 1;
    if (currentPage > lastPage) return lastPage;
    return currentPage;
  };

  const clampBlogEntries = (
    blogEntries: NodeListOf<Element>,
    currentPage: number,
  ) => {
    return [...blogEntries].filter((blogEntry) => {
      if (Number((blogEntry as HTMLElement).dataset.page) === currentPage)
        return blogEntry;
    });
  };

  let clampedBlogEntries = clampBlogEntries(blogEntries, currentPage);

  const clampedIndex = (currentIndex: number) => {
    if (clampedBlogEntries.length === 0) return 0;
    if (currentIndex < 0) return 0;
    if (currentIndex > clampedBlogEntries.length - 1)
      return clampedBlogEntries.length - 1;
    return currentIndex;
  };

  // define a custom event to handle mode changes async
  const NormalModeChangeEvent = new CustomEvent<VimMode>("MODE_CHANGE", {
    detail: "NORMAL",
  });

  const BlogModeChangeEvent = new CustomEvent<VimMode>("MODE_CHANGE", {
    detail: "BLOG",
  });

  // define a custom event to handle keybindings display
  const ToggleKeybindingsEvent = new CustomEvent<boolean>("TOGGLE_KEYBINDINGS");

  document.addEventListener("MODE_CHANGE", ((event: CustomEvent) => {
    if (clampedBlogEntries.length != 0) {
      if (event.detail == "NORMAL") {
        if (modeElement) modeElement.textContent = "NORMAL";
        let currSelection = clampedBlogEntries[currentIndex];
        currSelection.classList.remove("selected");
      } else {
        if (modeElement) modeElement.textContent = "BLOG";
        let currSelection = clampedBlogEntries[currentIndex];
        currSelection.classList.add("selected");
      }
    }
  }) as EventListener);

  const moveSelection = (delta: number) => {
    if (clampedBlogEntries.length != 0) {
      let currSelection = clampedBlogEntries[currentIndex];
      currSelection.classList.remove("selected");
      currentIndex = clampedIndex(currentIndex + delta);
      const nextSelection = clampedBlogEntries[currentIndex];
      nextSelection.classList.add("selected");
    }
  };

  const movePage = (delta: number) => {
    if (lastPage > 1 && clampedBlogEntries.length != 0) {
      currentPage = clampedPage(currentPage + delta);
      blogBox?.setAttribute("data-pagination-index", currentPage.toString());
      // reset selection
      let currSelection = clampedBlogEntries[currentIndex];
      currSelection.classList.remove("selected");
      clampedBlogEntries = clampBlogEntries(blogEntries, currentPage);
      currentIndex = 0;
      const nextSelection = clampedBlogEntries[currentIndex];
      nextSelection.classList.add("selected");
    }
  };

  document.addEventListener("keydown", (event) => {
    let pressedKey = event.key;
    // don't handle inputs when keybindings are open, unless quit
    if (
      isKeybindingsOverlayOpen() &&
      pressedKey !== "Escape" &&
      pressedKey !== "q"
    )
      return;
    switch (pressedKey) {
      case "p":
        if (window.location.pathname != "/portfolio") navigate("/portfolio");
        break;
      case "n":
        if (window.location.pathname != "/now") navigate("/now");
        break;
      case "b":
        if (window.location.pathname == "/" && currentMode == "NORMAL") {
          currentMode = "BLOG";
          document.dispatchEvent(BlogModeChangeEvent);
        }
        break;
      case "Escape":
        event.preventDefault();
        if (isKeybindingsOverlayOpen()) {
          document.dispatchEvent(ToggleKeybindingsEvent);
          break;
        }
        if (window.location.pathname == "/" && currentMode == "BLOG") {
          currentMode = "NORMAL";
          document.dispatchEvent(NormalModeChangeEvent);
        } else {
          navigate("/");
        }
        break;
      case "j":
        if (window.location.pathname == "/" && currentMode == "BLOG")
          moveSelection(1);
        break;
      case "k":
        if (window.location.pathname == "/" && currentMode == "BLOG")
          moveSelection(-1);
        break;
      case "h":
        if (window.location.pathname == "/" && currentMode == "BLOG")
          movePage(-1);
        break;
      case "l":
        if (window.location.pathname == "/" && currentMode == "BLOG")
          movePage(1);
        break;
      case "Enter":
        if (window.location.pathname == "/" && currentMode == "BLOG") {
          event.preventDefault();
          if (clampedBlogEntries.length != 0) {
            let currSelection = clampedBlogEntries[clampedIndex(currentIndex)];
            let anchorTagSlug = currSelection
              .querySelector(".blog-entry-parent-flex")
              .getElementsByTagName("a")[0]
              .getAttribute("href");
            if (anchorTagSlug) navigate(anchorTagSlug);
          }
        }
        break;
      case "?":
        document.dispatchEvent(ToggleKeybindingsEvent);
        break;
      case "q":
        if (isKeybindingsOverlayOpen()) {
          document.dispatchEvent(ToggleKeybindingsEvent);
        }

        break;
    }
  });
</script>
