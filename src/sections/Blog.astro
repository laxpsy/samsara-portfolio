---
import { getCollection } from "astro:content";
import BlogEntry from "../components/BlogEntry.astro";

const allBlogPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const BLOG_ROUTE = "/blog/";
---

<!-- TODO: pagination -->
<section class="section-flex">
  <div id="blog-box" box-="square" shear-="top">
    <div class="header">
      <span id="blog-box-heading">blog</span>
    </div>
    {
      allBlogPosts.map((post) => {
        return (
          <BlogEntry
            title={post.data.title}
            slug={`${BLOG_ROUTE}${post.id}`}
            timeToRead={0}
          />
        );
      })
    }
  </div>
</section>
<style>
  #blog-box {
    display: flex;
    width: 45%;
    min-height: 5lh;
    flex-direction: column;
  }

  #blog-box-heading {
    font-weight: 600;
  }

  #blog-box .selected {
    color: var(--mauve);
  }

  span {
    background-color: var(--background0);
    padding: 0 1ch;
  }
</style>

<script>
  let blogMode: boolean = false;
  let modeDiv = document.getElementById("mode");
  import { navigate } from "astro:transitions/client";
  document.addEventListener("keydown", (event) => {
    if (event.key == "b") {
      blogMode = true;
      modeDiv?.textContent == "BLOG";
    }
  });
</script>
