---
import { getCollection } from "astro:content";
import BlogEntry from "../components/BlogEntry.astro";

const allBlogPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const BLOG_ROUTE = "/blog/";
const PAGINATION_SIZE = 7;
---

<section class="section-flex">
  <div id="blog-box" box-="square" data-pagination-index={1} shear-="both">
    <div class="header">
      <span id="blog-box-heading">blog</span>
    </div>
    {
      allBlogPosts.map((post, index) => {
        return (
          <div
            class="blog-entry-parent-flex-wrapper"
            data-page={Math.floor(index / PAGINATION_SIZE) + 1}
          >
            <BlogEntry
              title={post.data.title}
              slug={`${BLOG_ROUTE}${post.id}`}
              dateOfPublication={post.data.pubDate.toLocaleDateString()}
            />
          </div>
        );
      })
    }
    <div id="blog-box-footer-div" style="align-self:end; gap:0">
      <span id="blog-box-footer">
        <span id="prev-page">&lt;</span><span
          id="page-number-current"
          style="font-weight:600">1</span
        >&sol;<span id="page-number-last" style="font-weight:600">1</span><span
          id="next-page">&gt;</span
        >
      </span>
    </div>
  </div>
</section>
<style>
  #blog-box {
    display: flex;
    min-width: 45%;
    max-width: 60%;
    min-height: 3lh;
    flex-direction: column;
    gap: 0.2ch;
    font-size: 1.5ch;
  }

  @media (max-width: 900px) {
    #blog-box {
      min-width: 70%;
      max-width: 80%;
      min-height: 3lh;
      font-size: 1.4ch;
    }
  }

  @media (max-width: 500px) {
    #blog-box {
      min-width: 90%;
      max-width: 95%;
      min-height: 3lh;
      font-size: 1.2ch;
    }
  }
  #blog-box-heading {
    font-weight: 600;
  }

  #blog-box .selected {
    color: var(--mauve);
  }

  #blog-box-heading {
    background-color: var(--background0);
    padding: 0 1ch;
  }
  #blog-box-footer {
    background-color: var(--background0);
    padding: 0 1ch;
  }
  #prev-page,
  #next-page {
    cursor: pointer;
    color: var(--mauve);
    font-weight: 600;
  }
</style>

<script>
  let dataPaginationIndex = 1;
  const blogBox = document.getElementById("blog-box");
  const blogEntries = blogBox?.querySelectorAll<HTMLElement>("[data-page]");
  const pageNumberCurrent = document.getElementById("page-number-current");
  const pageNumberLast = document.getElementById("page-number-last");
  const prevPage = document.getElementById("prev-page");
  const nextPage = document.getElementById("next-page");

  let lastPage = 1;
  let startX = 0;
  let endX = 0;
  let startY = 0;
  let endY = 0;

  if (pageNumberLast && blogEntries) {
    lastPage =
      blogEntries.length > 0
        ? Math.max(
            ...Array.from(blogEntries, (blogEntry) =>
              Number((blogEntry as HTMLElement).dataset.page),
            ),
          )
        : 1;
    if (lastPage != 1) pageNumberLast.innerText = lastPage.toString();
    else {
      const blogFooter = document.getElementById("blog-box-footer-div");
      blogFooter.style = "visibility:hidden";
    }
  }

  const clampedPage = (page: number) => {
    if (page < 1) return 1;
    if (page > lastPage) return lastPage;
    return page;
  };

  const updateVisiblePosts = () => {
    if (pageNumberCurrent)
      pageNumberCurrent.innerText = dataPaginationIndex.toString();
    if (blogEntries)
      blogEntries.forEach((blogEntry) => {
        blogEntry.style.display =
          parseInt(blogEntry.dataset.page ? blogEntry.dataset.page : "0") ===
          dataPaginationIndex
            ? ""
            : "none";
      });
    if (prevPage)
      prevPage.style.visibility =
        dataPaginationIndex <= 1 ? "hidden" : "visible";
    if (nextPage)
      nextPage.style.visibility =
        dataPaginationIndex >= lastPage ? "hidden" : "visible";
  };

  const navigatePage = (delta: number) => {
    dataPaginationIndex = clampedPage(dataPaginationIndex + delta);
    blogBox?.setAttribute(
      "data-pagination-index",
      dataPaginationIndex.toString(),
    );
    updateVisiblePosts();
  };

  const handleSwipe = (
    startX: number,
    endX: number,
    startY: number,
    endY: number,
  ) => {
    const threshold = 50;
    const dx = endX - startX;
    const dy = endY - startY;
    if (Math.abs(dy) > Math.abs(dx)) return;
    if (dx < -threshold) {
      navigatePage(1);
    }
    if (dx > threshold) {
      navigatePage(-1);
    }
  };

  updateVisiblePosts();

  prevPage?.addEventListener("click", () => {
    navigatePage(-1);
  });

  nextPage?.addEventListener("click", () => {
    navigatePage(1);
  });

  blogBox?.addEventListener("touchstart", (e) => {
    e.preventDefault();
    startX = e.changedTouches[0].screenX;
    startY = e.changedTouches[0].screenY;
  });

  blogBox?.addEventListener("touchend", (e) => {
    e.preventDefault();
    endX = e.changedTouches[0].screenX;
    endY = e.changedTouches[0].screenY;
    handleSwipe(startX, endX, startY, endY);
  });

  const paginationObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "data-pagination-index"
      ) {
        if (blogBox && blogBox.dataset.paginationIndex) {
          dataPaginationIndex = parseInt(blogBox.dataset.paginationIndex);
        }
        updateVisiblePosts();
      }
    });
  });

  paginationObserver.observe(blogBox as Node, {
    attributes: true,
    attributeFilter: ["data-pagination-index"],
  });
</script>
